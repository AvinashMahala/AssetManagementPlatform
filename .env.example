# Environment
NODE_ENV=development

# Server
PORT=5001

# Database
MAIN_DATABASE_URL=postgresql://user:pass@localhost:5432/asset_platform_main

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_ACCESS_TOKEN_EXPIRY_REMEMBER=1h
JWT_REFRESH_TOKEN_EXPIRY_REMEMBER=30d
BCRYPT_ROUNDS=12
# Optional: server-side pepper to harden refresh token hashes. Rotating this will invalidate existing refresh tokens.
AUTH__RefreshTokenPepper=your_random_pepper_here
# Optional (DEV ONLY): if true, the server will include the refresh token in API responses for testing. Do NOT enable in production.
AUTH__ExposeRefreshTokenInBody=true

# Rate limiting example: configure a strict policy for the refresh endpoint
# In ASP.NET configuration, dictionary keys are specified using the section name and the dictionary key as a subkey.
# Example (appsettings.json equivalent):
# "RateLimiting": {
#   "PerRoutePolicies": {
#     "POST:/api/v1/auth/refresh-token": { "Limit": 10, "WindowSeconds": 60, "BurstCapacity": 2, "ApplyTo": "IP" }
#   }
# }
# As environment variables this can be represented like:
# RateLimiting__PerRoutePolicies__POST:/api/v1/auth/refresh-token__Limit=10
# RateLimiting__PerRoutePolicies__POST:/api/v1/auth/refresh-token__WindowSeconds=60
# RateLimiting__PerRoutePolicies__POST:/api/v1/auth/refresh-token__BurstCapacity=2
# RateLimiting__PerRoutePolicies__POST:/api/v1/auth/refresh-token__ApplyTo=IP

# Frontend
VITE_API_URL=http://localhost:5001/api
FRONTEND_URL=http://localhost:5173

# Dev Tools Configuration
# Set to 'true' to show dev tools by default (only works in development mode)
VITE_SHOW_DEV_TOOLS=false
# Hotkey to toggle dev tools visibility (default: Ctrl+Shift+D)
VITE_DEV_TOOLS_HOTKEY=Ctrl+Shift+D

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Email Configuration
# Email functionality removed - using alternative password reset methods