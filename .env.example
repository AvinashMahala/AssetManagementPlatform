# Environment
NODE_ENV=development

# Server
PORT=5001

# Database
MAIN_DATABASE_URL=postgresql://user:pass@localhost:5432/asset_platform_main

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_ACCESS_TOKEN_EXPIRY_REMEMBER=1h
JWT_REFRESH_TOKEN_EXPIRY_REMEMBER=30d
BCRYPT_ROUNDS=12

# Frontend
VITE_API_URL=http://localhost:5001/api
FRONTEND_URL=http://localhost:5173

# Dev Tools Configuration
# Set to 'true' to show dev tools by default (only works in development mode)
VITE_SHOW_DEV_TOOLS=false
# Hotkey to toggle dev tools visibility (default: Ctrl+Shift+D)
VITE_DEV_TOOLS_HOTKEY=Ctrl+Shift+D

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Email Configuration
# Email functionality removed - using alternative password reset methods