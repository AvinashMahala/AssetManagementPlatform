{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API for Asset Management Platform",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run generate-swagger:watch\"",
    "dev:server": "tsx watch server.ts",
    "dev:debug": "tsx watch --inspect=0.0.0.0:5000 server.ts",
    "build": "tsc",
    "build:watch": "tsc -w",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "init-db": "tsx ../db/scripts/init.ts",
    "seed:templates": "tsx ../db/seeds/typescript/seed-receipt-templates.ts"
    ,
    "generate-swagger": "tsx scripts/generate-swagger.ts",
    "validate-swagger": "npx @apidevtools/swagger-cli validate public/openapi.json --verbose"
    ,
    "check-swagger": "npm run generate-swagger && npm run validate-swagger",
    "validate-endpoints": "node scripts/validate-endpoints.cjs",
    "validate-endpoints-report": "node scripts/validate-endpoints-report.cjs",
    "check-docs": "npm run generate-swagger && npm run validate-swagger && npm run validate-endpoints",
    "generate-swagger:watch": "onchange \"src/shared/config/swagger/apis/**/*.ts\" -- npm run generate-swagger",
    "dev:with-swagger": "concurrently \"npm run dev\" \"npm run generate-swagger:watch\""
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/pdfkit": "^0.17.3",
    "@types/puppeteer": "^7.0.4",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.3.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "openapi-types": "^12.1.3",
    "pdfkit": "^0.17.2",
    "pg": "^8.11.0",
    "puppeteer": "^21.6.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
    ,
    "onchange": "^7.1.0",
    "concurrently": "^8.2.0"
  }
}
