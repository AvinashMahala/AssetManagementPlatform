{
  "Jwt": {
    "Key": "dev_secret_key_change_this",
    "Issuer": "MyApp",
    "Audience": "MyAppUsers"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5434;Username=user;Password=pass;Database=asset_platform_main",
    "Files": "Host=localhost;Port=5433;Username=user;Password=pass;Database=asset_platform_files"
  },
  "RabbitMq": { "Host": "localhost", "Username": "guest", "Password": "guest" },
  "ServiceName": "assetmanagement-api",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog" }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/backend/log-.json",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "RequestLogging": {
    "Enabled": true,
    "IncludeRequestBody": false,
    "MaxBodySizeBytes": 4096,
    "SensitiveHeaders": [ "Authorization", "Cookie" ]
  },
  "SecurityHeaders": {
    "EnableCsp": true,
    "CspValue": "default-src 'self';",
    "EnableHsts": true,
    "HstsValue": "max-age=31536000; includeSubDomains",
    "EnableXContentTypeOptions": true,
    "XContentTypeOptionsValue": "nosniff",
    "EnableXFrameOptions": true,
    "XFrameOptionsValue": "DENY",
    "EnableReferrerPolicy": true,
    "ReferrerPolicyValue": "no-referrer"
  },
  "Maintenance": {
    "Enabled": false,
    "RetryAfterSeconds": 3600,
    "BypassHeader": "X-Maintenance-Bypass"
  }
}
