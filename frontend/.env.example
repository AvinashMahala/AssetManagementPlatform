# Environment variables example file for development and production
# Copy this to `.env.development` and `.env.production` as needed and update values

# The API base URL used by the frontend
VITE_API_URL=http://localhost:5001

# API request timeout (milliseconds)
# Recommended: 30000 (30s) - increase for slow networks or long-running operations
VITE_API_TIMEOUT=30000

# Disable authentication for local dev (true/false)
VITE_DISABLE_AUTH=false
# Google OAuth Configuration
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
