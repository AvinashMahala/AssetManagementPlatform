{
  "name": "asset-management-platform",
  "version": "1.0.0",
  "description": "Industrial-level asset management web application",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node start-dev.js",
    "start-dev": "node start-dev.js",
    "start-dev:win": "powershell -ExecutionPolicy Bypass -File start-dev.ps1",
    "setup:win": "powershell -ExecutionPolicy Bypass -File setup.ps1",
    "setup:unix": "bash setup.sh",
    "setup": "node scripts/setup.js",
    "setup:check": "node scripts/setup.js --dry-run",
    "dev:frontend": "yarn workspace frontend dev",
    "dev:backend": "yarn workspace backend dev",
    "build": "yarn workspaces run build",
    "test": "yarn workspaces run test",
    "lint": "yarn workspaces run lint"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "prettier": "^3.1.0"
  },
  "dependencies": {
    "express-rate-limit": "^8.2.1",
    "zod": "^4.2.1"
  }
}
