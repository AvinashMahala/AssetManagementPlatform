            "body": { "mode": "raw", "raw": "{\n  \"username\": \"ashakumar\",\n  \"email\": \"asha.kumar@example.com\",\n  \"password\": \"s3cureP@ss\",\n  \"firstName\": \"Asha\",\n  \"lastName\": \"Kumar\",\n  \"role\": \"user\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] }
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "body": "{ \"success\": true, \"data\": { \"id\": \"user_01EXAMPLE\", \"username\": \"ashakumar\", \"email\": \"asha.kumar@example.com\", \"role\": \"user\" }, \"tokens\": { \"accessToken\": \"<jwt>\", \"refreshToken\": \"<refresh>\" } }"
            },
            {
              "name": "400 Bad Request",
              "status": "Bad Request",
              "code": 400,
              "body": "{ \"success\": false, \"error\": { \"message\": \"Validation failed: email is required\" } }"
            },
            {
              "name": "500 Server Error",
              "status": "Internal Server Error",
              "code": 500,
              "body": "{ \"success\": false, \"error\": { \"message\": \"Unexpected server error\" } }"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response has user id and tokens', function () { var json = pm.response.json(); pm.expect(json.success).to.be.true; pm.expect(json.data).to.have.property('id'); pm.expect(json.tokens).to.have.property('accessToken'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"asha.kumar@example.com\",\n  \"password\": \"s3cureP@ss\"\n}" },
